# Explicit publication allowlist; tracked ignored files need explicit removal.
*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/.github/
!/.github/ISSUE_TEMPLATE/
!/.github/ISSUE_TEMPLATE/bug_report.yml
!/.github/ISSUE_TEMPLATE/feature_request.yml
!/docs/
!/docs/*.md
!/docs/images/
!/docs/images/*.png
!/docs/images/README.md
!/scripts/
!/scripts/GasDeck/
!/scripts/GasDeck/main.lua
*.luac
*.bin
*.cfg
*.dat
*.log
*.csv
*.zip
*.7z
*.rar
notes/
tests/
archive/
releases/
models/
bitmaps/
audio/
.simulator/
